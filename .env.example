PORT=3000
BASE_URL=http://localhost:3000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB
DYNAMODB_TABLE_NAME=url-shortener

# For production (AWS deployment with IAM role)
# BASE_URL=http://your-alb-dns-name.region.elb.amazonaws.com
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY not needed on EC2 with IAM role
